{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nom de fabrique de données",
			"defaultValue": "adfbougrine"
		},
		"AzureSynapseArtifacts_properties_typeProperties_endpoint": {
			"type": "string",
			"defaultValue": "https://synapsebougrine.dev.azuresynapse.net"
		},
		"LS_ADLS_Destination_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsbougrine.dfs.core.windows.net/"
		},
		"LS_Blob_Source_properties_typeProperties_serviceEndpoint": {
			"type": "string",
			"defaultValue": "https://sourcebougrine.blob.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI pour le compte de stockage contenant des modèles ARM liés"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Jeton SAS pour le compte de stockage contenant des modèles ARM liés"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfbougrine_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSynapseArtifacts_properties_typeProperties_endpoint": {
						"value": "[parameters('AzureSynapseArtifacts_properties_typeProperties_endpoint')]"
					},
					"LS_ADLS_Destination_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Destination_properties_typeProperties_url')]"
					},
					"LS_Blob_Source_properties_typeProperties_serviceEndpoint": {
						"value": "[parameters('LS_Blob_Source_properties_typeProperties_serviceEndpoint')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}